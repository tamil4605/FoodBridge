# ==============================================================
# FoodBridge Application Properties Template (Example)
# ==============================================================
server.port=8080
spring.application.name=foodbridge

# MySQL Connection (Replace with your local credentials)
spring.datasource.url=jdbc:mysql://localhost:3306/foodbridge_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=YOUR_MYSQL_USERNAME
spring.datasource.password=YOUR_MYSQL_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# Demo Seed Data (true in development to populate Chennai demo records)
foodbridge.demo-data.enabled=true
